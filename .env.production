# .env.production
# PostgreSQL
POSTGRES_USER=dpwadmin
POSTGRES_PASSWORD=SILNÉ_HESLO_K_DB
POSTGRES_DB=dpwdb

# Flask backend
# For local runtime test (db container): postgresql+psycopg://dpwadmin:PASSWORD@db/dpwdb
# For Azure (PostgreSQL Flexible Server):
#   postgresql+psycopg://dpwadmin:PASSWORD@<server>.postgres.database.azure.com/dpwdb?sslmode=require
DATABASE_URL=postgresql+psycopg://dpwadmin:SILNÉ_HESLO_K_DB@db/dpwdb

SECRET_KEY=NÁHODNÝ_TAJNÝ_KLÍČ_MIN_32_ZNAKŮ
JWT_SECRET_KEY=NÁHODNÝ_JWT_KLÍČ_MIN_32_ZNAKŮ

# Comma-separated allowed CORS origins (no trailing slash)
# For Azure: https://dpw-frontend.azurewebsites.net
CORS_ORIGINS=http://localhost:80,http://localhost:8000

# Flask environment
FLASK_CONFIG=production
