{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",

  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "switzerlandnorth",
      "metadata": { "description": "Azure region for all resources." }
    },
    "acrName": {
      "type": "string",
      "metadata": { "description": "ACR registry name without .azurecr.io, e.g. diveplanweb" }
    },
    "acrResourceGroup": {
      "type": "string",
      "defaultValue": "[resourceGroup().name]",
      "metadata": { "description": "Resource group where ACR exists (default: current RG)." }
    },
    "acrLoginServer": {
      "type": "string",
      "metadata": { "description": "ACR login server, e.g. diveplanweb.azurecr.io" }
    },
    "backendName": {
      "type": "string",
      "metadata": { "description": "App Service name for backend, e.g. dpw-backend" }
    },
    "frontendName": {
      "type": "string",
      "metadata": { "description": "App Service name for frontend, e.g. dpw-frontend" }
    },
    "dbServerName": {
      "type": "string",
      "metadata": { "description": "PostgreSQL Flexible Server name (globally unique), e.g. dpw-pg-server" }
    },
    "dbName": {
      "type": "string",
      "defaultValue": "dpwdb",
      "metadata": { "description": "Database name inside PostgreSQL." }
    },
    "dbAdminUser": {
      "type": "string",
      "defaultValue": "dpwadmin",
      "metadata": { "description": "PostgreSQL administrator login." }
    },
    "dbAdminPassword": {
      "type": "securestring",
      "metadata": { "description": "PostgreSQL administrator password (min 8 chars, upper+lower+digit+special)." }
    },
    "secretKey": {
      "type": "securestring",
      "metadata": { "description": "Flask SECRET_KEY — long random string." }
    },
    "jwtSecretKey": {
      "type": "securestring",
      "metadata": { "description": "Flask JWT_SECRET_KEY — long random string." }
    }
  },

  "variables": {
    "planName": "dpw-app-plan",
    "dbUrl": "[concat('postgresql+psycopg://', parameters('dbAdminUser'), ':', parameters('dbAdminPassword'), '@', parameters('dbServerName'), '.postgres.database.azure.com/', parameters('dbName'), '?sslmode=require&connect_timeout=5')]",
    "frontendUrl": "[concat('https://', parameters('frontendName'), '.azurewebsites.net')]",
    "backendUrl": "[concat('https://', parameters('backendName'), '.azurewebsites.net')]"
  },

  "resources": [

    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "B1", "tier": "Basic" },
      "properties": { "reserved": true }
    },

    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2022-12-01",
      "name": "[parameters('dbServerName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "administratorLogin": "[parameters('dbAdminUser')]",
        "administratorLoginPassword": "[parameters('dbAdminPassword')]",
        "version": "16",
        "storage": { "storageSizeGB": 32 },
        "backup": { "backupRetentionDays": 7, "geoRedundantBackup": "Disabled" },
        "highAvailability": { "mode": "Disabled" },
        "authConfig": {
          "activeDirectoryAuth": "Disabled",
          "passwordAuth": "Enabled"
        }
      }
    },

    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2022-12-01",
      "name": "[concat(parameters('dbServerName'), '/', parameters('dbName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('dbServerName'))]"
      ],
      "properties": {}
    },

    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2022-12-01",
      "name": "[concat(parameters('dbServerName'), '/AllowAllWindowsAzureIps')]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('dbServerName'))]"
      ],
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      }
    },

    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "kind": "app,linux,container",
      "name": "[parameters('backendName')]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases', parameters('dbServerName'), parameters('dbName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/firewallRules', parameters('dbServerName'), 'AllowAllWindowsAzureIps')]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "siteConfig": {
          "linuxFxVersion": "[concat('DOCKER|', parameters('acrLoginServer'), '/dpw-backend:latest')]",
          "acrUseManagedIdentityCreds": true,
          "appSettings": [
            { "name": "WEBSITES_PORT",  "value": "8000" },
            { "name": "FLASK_CONFIG",   "value": "production" },
            { "name": "DATABASE_URL",   "value": "[variables('dbUrl')]" },
            { "name": "SECRET_KEY",     "value": "[parameters('secretKey')]" },
            { "name": "JWT_SECRET_KEY", "value": "[parameters('jwtSecretKey')]" },
            { "name": "CORS_ORIGINS",   "value": "[variables('frontendUrl')]" }
          ]
        }
      }
    },

    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "kind": "app,linux,container",
      "name": "[parameters('frontendName')]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "siteConfig": {
          "linuxFxVersion": "[concat('DOCKER|', parameters('acrLoginServer'), '/dpw-frontend:latest')]",
          "acrUseManagedIdentityCreds": true,
          "appSettings": [
            { "name": "WEBSITES_PORT", "value": "80" },
            { "name": "BACKEND_URL",   "value": "[variables('backendUrl')]" }
          ]
        }
      }
    },

    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, parameters('acrName'), parameters('backendName'), 'AcrPull')]",
      "scope": "[resourceId(subscription().subscriptionId, parameters('acrResourceGroup'), 'Microsoft.ContainerRegistry/registries', parameters('acrName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('backendName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('backendName')), '2023-01-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },

    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, parameters('acrName'), parameters('frontendName'), 'AcrPull')]",
      "scope": "[resourceId(subscription().subscriptionId, parameters('acrResourceGroup'), 'Microsoft.ContainerRegistry/registries', parameters('acrName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('frontendName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('frontendName')), '2023-01-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }

  ],

  "outputs": {
    "backendUrl": {
      "type": "string",
      "value": "[variables('backendUrl')]"
    },
    "frontendUrl": {
      "type": "string",
      "value": "[variables('frontendUrl')]"
    },
    "dbServer": {
      "type": "string",
      "value": "[concat(parameters('dbServerName'), '.postgres.database.azure.com')]"
    }
  }
}
